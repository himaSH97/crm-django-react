DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AWS_STORAGE_BUCKET_NAME=sbtvl-dev
AWS_S3_REGION_NAME=us-east-1
# Optional: set AWS_PROFILE if your CLI credentials use a named profile.

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSLMODE=disable
DB_CHANNEL_BINDING=disable

# Production: set DJANGO_ENV=production, DJANGO_DEBUG=false, a generated
# DJANGO_SECRET_KEY, explicit DJANGO_ALLOWED_HOSTS, and DB_SSLMODE=require.
# Set DJANGO_CORS_ALLOWED_ORIGINS to the exact deployed frontend origin(s),
# and configure DJANGO_CSRF_TRUSTED_ORIGINS for HTTPS frontend origins.
# Only enable HSTS subdomains/preload when every affected hostname uses HTTPS.

